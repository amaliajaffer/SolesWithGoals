---
import Base from '../../layouts/Base.astro';
import Gate from '../../components/Gate.astro';
import FilmIntro from '../../components/FilmIntro.astro';
import GoalRing from '../../components/GoalRing.astro';
import PageHead from '../../components/PageHead.astro';
import SubTabs from '../../components/SubTabs.astro';
import TrackMedia from '../../components/TrackMedia.astro';
import { variantPaths, link, type Variant } from '../../lib/variant';
import { copy } from '../../data/copy';
import { site } from '../../data/site';

export function getStaticPaths() {
  return variantPaths();
}
const { variant } = Astro.props as { variant: Variant };
const photos = variant === 'photos';
const essay = copy.essay;
const tabs = [
  { id: 'about-us', label: 'About us' },
  { id: 'values', label: 'Our values' },
  { id: 'story', label: 'Amalia’s story' },
];
const keys = ['key--arc', 'key--dots', 'key--dot'];
---

<Base title="About" description={copy.vision} variant={variant} current="about" ground="rasp">
  <PageHead title={copy.startLine} tone="rasp" />
  <SubTabs items={tabs} />

  <section id="about-us" class="sec target" aria-label="About us">
    <div class="wrap stack">
      <FilmIntro variant={variant} />
      <div class="two">
        <div class="stack-s">
          <h2 class="eyebrow">Our vision</h2>
          <p class="lead strong">{copy.vision}</p>
        </div>
        <div class="stack-s">
          <h2 class="eyebrow">Our mission</h2>
          <p class="lead strong">
            {copy.mission}<Gate confirmed={site.confirmed.sop} note="needs SOP’s written OK (D2)" inline>{copy.missionSop}</Gate>.
          </p>
        </div>
      </div>
      <h2 class="h2 who-title">Who we are</h2>
      <div class="stack-m measure">
        {
          copy.whoWeAre.map((part, index) => {
            const text = <p class:list={index === 0 ? 'lead body' : 'body'}>{part.text}</p>;
            return part.sop ? (
              <Gate confirmed={site.confirmed.sop} note="SOP affiliation and figure: needs SOP’s written OK (D2)">
                {text}
              </Gate>
            ) : (
              text
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="sec band-cream" aria-labelledby="name-title">
    <div class="wrap stack">
      <h2 class="h2" id="name-title">The name</h2>
      <div class="two">
        {
          copy.name.map((part) => (
            <div class="stack-s">
              <p class="display-l rasp">{part.word}</p>
              <p class="lead">{part.text}</p>
            </div>
          ))
        }
      </div>
      <h3 class="h3 ring-title">{copy.ring.title}</h3>
      <div class="ring-explain">
        <GoalRing size={320} draw class="big-ring" label="The Goal Ring: a solid arc, a dotted arc and a dot where start meets finish" />
        <ul class="callouts">
          {
            copy.ring.parts.map((part, index) => (
              <li class="callout">
                <span class:list={['key', keys[index]]} aria-hidden="true" />
                <div class="stack-s">
                  <p class="h4">{part.lead}</p>
                  <p class="body">{part.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="lead">{copy.ring.close}</p>
    </div>
  </section>

  <section id="values" class="sec target" aria-labelledby="values-title">
    <div class="wrap stack">
      <h2 class="h2" id="values-title">Our values</h2>
      <ul class="values">
        {
          copy.values.map((value) => (
            <li class="stack-s value">
              <h3 class="h4">{value.title}</h3>
              <p class="body">{value.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="story" class="sec band-cream target" aria-labelledby="story-title">
    <div class:list={['wrap', 'story', { 'story--text': !photos }]}>
      {photos && <TrackMedia id="story-portrait" shape="portrait" class="story-media" />}
      <div class="stack-m story-text">
        <p class="eyebrow">Amalia’s story</p>
        <h2 class="h2" id="story-title">{essay.opening}</h2>
        <blockquote class="stack-m">
          <p class="h3 rasp">{essay.quote}</p>
          <footer class="small">{essay.byline}</footer>
        </blockquote>
        <a class="btn self-start" href={link(variant, 'stories#why-i-run')}>Read “Why I run”</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .target {
    scroll-margin-top: var(--tabs-h);
  }
  .strong {
    font-weight: 700;
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-32) var(--space-64);
  }
  .who-title {
    margin-top: var(--space-32);
  }
  .ring-title {
    margin-top: var(--space-16);
  }
  /* Her ring drawn once, with each line keyed to its part. */
  .ring-explain {
    display: grid;
    grid-template-columns: minmax(0, 320px) minmax(0, 640px);
    align-items: center;
    gap: var(--space-48) var(--space-96);
  }
  .ring-explain :global(.big-ring) {
    width: 100%;
    height: auto;
  }
  .callouts {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .callout {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--space-24);
    align-items: start;
  }
  .key {
    display: block;
    margin-top: 10px;
  }
  .key--arc {
    width: 48px;
    height: 6px;
    border-radius: 3px;
    background: var(--navy);
  }
  .key--dots {
    width: 48px;
    height: 8px;
    background: radial-gradient(circle, var(--rasp) 3px, transparent 3.5px) 0 50% / 16px 8px repeat-x;
  }
  .key--dot {
    width: 16px;
    height: 16px;
    margin-top: 5px;
    border-radius: var(--radius-pill);
    background: var(--rasp);
  }
  .h4 {
    font-family: var(--font-display);
  }
  .values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-32);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .value {
    gap: var(--space-8);
  }
  .story {
    display: flex;
    align-items: center;
    gap: var(--space-64);
  }
  .story :global(.story-media) {
    flex: 0 0 min(420px, 36%);
  }
  .story-text {
    flex: 1 1 0;
    min-width: 0;
    max-width: 860px;
  }
  /* Without her clip: the opening line on the left, her words on the right. */
  .story--text .story-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 640px);
    align-items: start;
    gap: var(--space-24) var(--space-64);
    max-width: none;
  }
  .story--text .eyebrow {
    grid-column: 1;
    grid-row: 1;
  }
  .story--text h2 {
    grid-column: 1;
    grid-row: 2;
  }
  .story--text blockquote {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  .story--text .btn {
    grid-column: 2;
    grid-row: 3;
  }
  @media (max-width: 1023px) {
    .values {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 760px) {
    .two,
    .values,
    .ring-explain {
      grid-template-columns: 1fr;
    }
    .ring-explain :global(.big-ring) {
      width: min(200px, 60%);
    }
    .story {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-32);
    }
    .story :global(.story-media) {
      flex: none;
      width: min(100%, 420px);
    }
    .story--text .story-text {
      display: flex;
    }
  }
</style>
