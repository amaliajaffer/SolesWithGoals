---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import GoalRing from '../../components/GoalRing.astro';
import Gate from '../../components/Gate.astro';
import FilmIntro from '../../components/FilmIntro.astro';
import stadium from '../../assets/photos/stadium.jpg';
import { variantPaths, type Variant } from '../../lib/variant';
import { copy } from '../../data/copy';
import { site } from '../../data/site';

export function getStaticPaths() {
  return variantPaths();
}
const { variant } = Astro.props as { variant: Variant };
const photos = variant === 'photos';
const essay = copy.essay;
---

<Base title="About" description={copy.vision} variant={variant} current="about">
  <section class="sec intro">
    <div class="wrap stack">
      <p class="eyebrow">About</p>
      <h1 class="h1 title">{copy.startLine}</h1>
    </div>
  </section>

  <FilmIntro variant={variant} />

  <nav class="tabs" aria-label="On this page">
    <div class="wrap">
      <a href="#about-us" class="is-cur" aria-current="location">About us</a>
      <a href="#values">Our values</a>
      <a href="#story">Amalia’s story</a>
    </div>
  </nav>

  <section id="about-us" class="sec target">
    <div class="wrap two">
      <article class="card card--navy pad">
        <p class="eyebrow">Vision</p>
        <p class="big">{copy.vision}</p>
      </article>
      <article class="card card--outline pad">
        <p class="eyebrow">Mission</p>
        <p class="mid">
          {copy.mission}<Gate confirmed={site.confirmed.sop} note="needs SOP’s written OK (D2)" inline>{copy.missionSop}</Gate>.
        </p>
      </article>
    </div>
  </section>

  <section class="sec sec--line">
    <div class="narrow stack who">
      <h2 class="eyebrow">Who we are</h2>
      {
        copy.whoWeAre.map((part) =>
          part.sop ? (
            <Gate confirmed={site.confirmed.sop} note="SOP affiliation and figure: needs SOP’s written OK (D2)">
              <p>{part.text}</p>
            </Gate>
          ) : (
            <p>{part.text}</p>
          )
        )
      }
    </div>
  </section>

  <section class="sec sec--line">
    <div class="wrap three">
      <div class="stack">
        <p class="eyebrow">Origin story</p>
        <p>{copy.origin}</p>
      </div>
      <div class="stack">
        <p class="eyebrow">Brand essence</p>
        <p class="essence">{copy.essence}</p>
        <p>{copy.essenceBody}</p>
      </div>
      <div class="stack">
        <p class="eyebrow">The name</p>
        {copy.name.map((part) => <p><strong>{part.word}</strong> = {part.text}</p>)}
      </div>
    </div>
  </section>

  <section class="sec band-navy on-dark">
    <div class="wrap split">
      <div class="ring-wrap">
        <GoalRing tone="reversed" size={300} draw label="The Goal Ring: a solid arc, a dotted arc and a dot where start meets finish" />
      </div>
      <div class="stack ring-text">
        <p class="eyebrow">The Goal Ring</p>
        <h2 class="h2">{copy.ring.title}</h2>
        {copy.ring.parts.map((part) => <p><strong class={`tone-${part.tone}`}>{part.lead}</strong> {part.text}</p>)}
        <p>{copy.ring.close}</p>
      </div>
    </div>
  </section>

  <section id="values" class="sec target">
    <div class="wrap stack gap-l">
      <h2 class="eyebrow">Our values</h2>
      <div class="grid">
        {
          copy.values.map((value) => (
            <article class="card value-card" data-inview>
              <h3 class="h3"><span class="mark">{value.title}</span></h3>
              <p class="value">{value.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="story" class="sec band-cream target">
    <div class="narrow essay">
      <p class="eyebrow">Amalia’s story · Why I run</p>
      <p class="opening">“{essay.opening}</p>
      {essay.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <div class="beats">{essay.beats.map((beat) => <p>{beat}</p>)}</div>
      {essay.middle.map((paragraph) => <p>{paragraph}</p>)}
      {
        photos && (
          <figure class="track">
            <div class="photo-oval">
              <Image src={stadium} widths={[400, 600, 800]} sizes="(max-width: 760px) 80vw, 400px" alt="Amalia racing on an outdoor track" />
            </div>
          </figure>
        )
      }
      {essay.end.map((paragraph) => <p>{paragraph}</p>)}
      <div class="closing">
        <p>{essay.closing[0]}</p>
        <p>{essay.closing[1]}”</p>
      </div>
      <p class="small">{essay.byline}</p>
    </div>
  </section>
</Base>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.tabs a'));
  const targets = links.map((a) => document.querySelector<HTMLElement>(a.hash)).filter((el): el is HTMLElement => el !== null);
  const mark = (id: string) => {
    for (const a of links) {
      const on = a.hash === `#${id}`;
      a.classList.toggle('is-cur', on);
      if (on) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    }
  };
  const spy = () => {
    const line = window.innerHeight * 0.35;
    let current = targets[0]?.id;
    for (const target of targets) if (target.getBoundingClientRect().top <= line) current = target.id;
    if (current) mark(current);
  };
  window.addEventListener('scroll', spy, { passive: true });
  spy();
</script>

<style>
  .intro {
    padding-bottom: 32px;
  }
  .title {
    max-width: 16ch;
  }
  .tabs {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--navy-100);
    background: var(--white);
  }
  .tabs .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 32px;
  }
  .tabs a {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    color: var(--navy);
    font-size: 17px;
    text-decoration: none;
    background: linear-gradient(var(--rasp), var(--rasp)) left calc(100% - 2px) / 0 3px no-repeat;
    transition: background-size 0.3s ease;
  }
  .tabs a:hover,
  .tabs a.is-cur {
    background-size: 100% 3px;
  }
  .tabs a.is-cur {
    font-weight: 700;
  }
  .target {
    scroll-margin-top: 64px;
  }
  .two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 24px;
  }
  .pad {
    padding: 32px;
  }
  .card--navy .eyebrow {
    color: var(--aqua);
  }
  .big {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
  }
  .mid {
    font-size: 20px;
  }
  .three {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 40px;
  }
  .essence {
    color: var(--rasp);
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 800;
    line-height: 1.1;
  }
  .ring-wrap {
    display: flex;
    flex: 0 1 320px;
    justify-content: center;
  }
  .ring-text {
    gap: 18px;
  }
  .tone-aqua {
    color: var(--aqua);
  }
  .tone-rasp {
    color: var(--rasp-on-dark);
  }
  .gap-l {
    gap: 28px;
  }
  .value {
    font-size: 16px;
  }
  .value-card {
    --mark-delay: 0.45s;
  }
  .who {
    gap: 18px;
  }
  .who p {
    font-size: 19px;
  }
  .essay {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .track {
    margin: 0;
    align-self: center;
    width: min(400px, 100%);
  }
  .opening {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.4vw, 46px);
    font-weight: 800;
    line-height: 1.15;
  }
  .beats p {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.35;
  }
  .closing p {
    font-family: var(--font-display);
    font-size: clamp(26px, 2.8vw, 36px);
    font-weight: 800;
    line-height: 1.25;
  }
</style>
