---
import Base from '../../layouts/Base.astro';
import GoalRing from '../../components/GoalRing.astro';
import { variantPaths, link, type Variant } from '../../lib/variant';
import { copy } from '../../data/copy';

export function getStaticPaths() {
  return variantPaths();
}
const { variant } = Astro.props as { variant: Variant };
const s = copy.stories;
// The intro's first sentence: the whole intro runs past the 155 characters search results show.
const description = s.intro.slice(0, s.intro.indexOf('. ') + 1);
---

<Base title="Stories of Change" description={description} variant={variant} current="stories">
  <section class="sec">
    <div class="wrap stack gap-m">
      <p class="eyebrow">Stories of Change</p>
      <h1 class="h1 title">{s.title}</h1>
      <p class="lead">{s.intro}</p>
    </div>
  </section>

  <section class="sec band-navy on-dark">
    <div class="wrap split top">
      <div class="stack gap-m">
        <p class="eyebrow">Who we’re running for</p>
        <h2 class="h2">{s.whoTitle}</h2>
      </div>
      <div class="stack gap-m">
        {s.who.map((paragraph) => <p class="measure">{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap stack gap-l">
      <div class="stack gap-s">
        <h2 class="h2">{s.entries.length ? 'Our runners' : s.comingTitle}</h2>
        {!s.entries.length && <p class="lead">{s.comingText}</p>}
      </div>
      <div class="grid">
        {
          s.entries.length
            ? s.entries.map((entry) => (
                <article class="card story">
                  {entry.photo && <img class="avatar" src={entry.photo} alt={entry.name} width="96" height="96" loading="lazy" />}
                  <h3 class="h3">{entry.name}</h3>
                  <p>“{entry.line}”</p>
                </article>
              ))
            : [0, 1, 2].map(() => (
                <div class="card story story--soon" aria-hidden="true">
                  <div class="avatar avatar--soon">
                    <GoalRing size={56} />
                  </div>
                  <span class="bar bar--name" />
                  <span class="bar" />
                  <span class="bar bar--short" />
                </div>
              ))
        }
      </div>
      <a class="why card" href={link(variant, 'about#story')}>
        <span class="eyebrow">Why I run</span>
        <span class="h3">Amalia’s own story, from quitting running to living by it</span>
      </a>
      <p class="consent">{s.consent}</p>
    </div>
  </section>
</Base>

<style>
  .title {
    max-width: 16ch;
  }
  .gap-m {
    gap: 20px;
  }
  .top {
    align-items: flex-start;
  }
  .gap-s {
    gap: 10px;
  }
  .gap-l {
    gap: 28px;
  }
  .story {
    align-items: flex-start;
  }
  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 999px;
    object-fit: cover;
  }
  /* "Coming soon" cards: an empty card shape, no made-up names or photos. */
  .avatar--soon {
    display: grid;
    place-items: center;
    background: var(--cream);
    border: 2px dashed var(--navy-200);
  }
  .bar {
    display: block;
    width: 100%;
    height: 12px;
    border-radius: 999px;
    background: var(--navy-100);
  }
  .bar--name {
    width: 55%;
    height: 18px;
    margin-top: 6px;
  }
  .bar--short {
    width: 70%;
  }
  .story--soon {
    border-style: dashed;
  }
  .why {
    max-width: 860px;
    gap: 6px;
    background: var(--cream);
  }
  .consent {
    max-width: 860px;
    padding: 24px 28px;
    border: 2px solid var(--navy);
    border-radius: var(--radius);
  }
</style>
