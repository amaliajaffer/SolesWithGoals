---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import Art from '../../components/Art.astro';
import Closing from '../../components/Closing.astro';
import { variantPaths, link, type Variant } from '../../lib/variant';
import { copy } from '../../data/copy';

export function getStaticPaths() {
  return variantPaths();
}
const { variant } = Astro.props as { variant: Variant };
const photos = variant === 'photos';
const s = copy.stories;
const essay = copy.essay;
const [statement, ...rest] = s.who;
// The intro's first sentence: the whole intro runs past the 155 characters search results show.
const description = s.intro.slice(0, s.intro.indexOf('. ') + 1);
---

<Base title="Stories of Change" description={description} variant={variant} current="stories">
  <PageHead title={s.title} lead={s.intro} />

  <article id="why-i-run" class="sec essay-sec" aria-labelledby="essay-title">
    <div class="wrap essay-grid">
      <header class="essay-head stack-m">
        <p class="eyebrow">Why I run</p>
        <h2 class="display-l" id="essay-title">{essay.opening}</h2>
        <p class="small">{essay.byline}</p>
      </header>
      <div class="essay">
        {essay.paragraphs.map((paragraph, index) => <p class:list={index === 0 ? 'lead' : 'body'}>{paragraph}</p>)}
        <div class="beats">{essay.beats.map((beat) => <p class="h3">{beat}</p>)}</div>
        {essay.middle.map((paragraph) => <p class="body">{paragraph}</p>)}
        {
          photos && (
            <figure class="track">
              <img src="/media/stadium.jpg" width="640" height="957" loading="lazy" decoding="async" alt="Amalia racing on an outdoor track" />
            </figure>
          )
        }
        {essay.end.map((paragraph) => <p class="body">{paragraph}</p>)}
        <p class="quote closing-lines">{essay.closing[0]} {essay.closing[1]}</p>
      </div>
    </div>
  </article>

  <section class="sec band-cream" aria-labelledby="who-title">
    <div class="wrap stack">
      <h2 class="eyebrow" id="who-title">Who we’re running for</h2>
      <p class="lead measure">{statement}</p>
      {rest.map((paragraph) => <p class="lead body measure">{paragraph}</p>)}
    </div>
  </section>

  <section class="sec" aria-label="Stories to come">
    <div class="wrap stack">
      {
        s.entries.length ? (
          <div class="entries">
            {s.entries.map((entry) => (
              <article class="entry">
                {entry.photo && <img class="avatar" src={entry.photo} alt={entry.name} width="96" height="96" loading="lazy" />}
                <h3 class="h4">{entry.name}</h3>
                <p class="body">“{entry.line}”</p>
              </article>
            ))}
          </div>
        ) : (
          <ComingSoon title={s.comingText}>
            <Art slot="art" name="finish-tape" width={480} height={240} />
          </ComingSoon>
        )
      }
      <p class="body measure">{s.consent}</p>
    </div>
  </section>

  <Closing title={copy.involved.title}>
    <a class="btn btn--on-rasp" href={link(variant, 'get-involved')}>Get involved</a>
  </Closing>
</Base>

<style>
  .essay-sec {
    scroll-margin-top: 0;
  }
  /* Opening line and byline stay in view on the left while the essay runs on the right. */
  .essay-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 640px);
    align-items: start;
    gap: var(--space-32) var(--space-64);
  }
  .essay-head {
    position: sticky;
    top: var(--space-32);
  }
  @media (max-width: 1023px) {
    .essay-grid {
      grid-template-columns: 1fr;
    }
    .essay-head {
      position: static;
    }
  }
  .essay {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    max-width: 640px;
  }
  .essay .lead {
    color: var(--navy);
  }
  .beats {
    padding: var(--space-8) 0;
  }
  .beats p {
    color: var(--rasp);
  }
  .closing-lines {
    margin-top: var(--space-16);
  }
  .track {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    margin: var(--space-16) 0;
    border-radius: var(--radius-pill);
    background: var(--aqua);
  }
  .track :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .entries {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-24);
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding: var(--space-24);
    border: 1px solid var(--navy-100);
    border-radius: var(--radius);
  }
  .avatar {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-pill);
    object-fit: cover;
  }
</style>
