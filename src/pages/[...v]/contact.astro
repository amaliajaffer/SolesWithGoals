---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import { variantPaths, type Variant } from '../../lib/variant';
import { copy } from '../../data/copy';
import { site } from '../../data/site';

export function getStaticPaths() {
  return variantPaths();
}
const { variant } = Astro.props as { variant: Variant };
const forms = site.forms;
const email = site.email ? `mailto:${site.email}` : null;
const coachLine = copy.involved.roles.find((role) => role.id === 'coach')?.text ?? null;
// Each route opens her form for it, or the project email; until then one card says the details are coming.
const routes = [
  { title: 'Runners and families', text: null, href: forms.run ?? forms.families ?? email },
  { title: 'Coaches and volunteers', text: coachLine, href: forms.coach ?? forms.volunteer ?? email },
  { title: 'Partners and press', text: null, href: forms.partner ?? email },
];
// Only routes with somewhere to go are shown; the rest wait in one card.
const ready = routes.filter((route) => route.href);
const waiting = ready.length < routes.length;
---

<Base title="Contact" description={`Contact ${site.name}: runners and families, coaches and volunteers, partners and press.`} variant={variant} current="contact">
  <PageHead title="Contact" />

  <section class="sec" aria-label="Ways to reach us">
    <div class="wrap stack">
      {
        ready.length > 0 && (
          <div class="routes">
            {ready.map((route) => (
              <article class="route">
                <h2 class="h3">{route.title}</h2>
                {route.text && <p class="body">{route.text}</p>}
                <a class="btn" href={route.href!} rel={route.href!.startsWith('http') ? 'noopener' : undefined}>
                  {route.href!.startsWith('mailto:') ? 'Email us' : 'Open the form'}
                  <span class="sr-only"> ({route.title})</span>
                </a>
              </article>
            ))}
          </div>
        )
      }
      {
        waiting && (
          <ComingSoon title="Our contact details are coming soon.">
          </ComingSoon>
        )
      }
      {
        site.email && (
          <p class="body">
            Write to us: <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        )
      }
      <p class="tags">
        {site.socials.map((social) => <a href={social.url} rel="noopener">{social.label}</a>)}
        <span>{site.hashtag}</span>
      </p>
    </div>
  </section>
</Base>

<style>
  .routes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-24);
  }
  .route {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-12);
    padding-top: var(--space-16);
    border-top: 6px solid var(--navy);
  }
  .route .btn {
    margin-top: auto;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    color: var(--navy-700);
    font-weight: 700;
  }
  @media (max-width: 900px) {
    .routes {
      grid-template-columns: 1fr;
    }
  }
</style>
