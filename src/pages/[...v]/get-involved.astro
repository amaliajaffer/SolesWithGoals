---
import Base from '../../layouts/Base.astro';
import Gate from '../../components/Gate.astro';
import { variantPaths, link, type Variant } from '../../lib/variant';
import { copy } from '../../data/copy';
import { site } from '../../data/site';

export function getStaticPaths() {
  return variantPaths();
}
const { variant } = Astro.props as { variant: Variant };
const forms = site.forms as Record<string, string | null>;
---

<Base title="Get involved" description={copy.involved.title} variant={variant} current="involved">
  <section class="sec band-cream">
    <div class="wrap stack gap-m">
      <p class="eyebrow">Get involved · Contact</p>
      <h1 class="h1 title">{copy.involved.title}</h1>
      <p class="lead">{copy.involved.sub}</p>
      {
        site.email ? (
          <p class="contact">
            Write to us: <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        ) : (
          <div class="soon self-start">
            <strong>Contact details coming soon</strong>
          </div>
        )
      }
      <p class="tags">
        {site.socials.map((social) => <a href={social.url} rel="noopener">{social.label}</a>)}
        <span>{site.hashtag}</span>
      </p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap grid roles">
      {
        copy.involved.roles.map((role) => (
          <article class="card" id={role.id}>
            <h2 class="h3">{role.title}</h2>
            {role.text && <p>{role.text}</p>}
            <div class="push">
              {forms[role.form] ? (
                <a class="btn btn--primary" href={forms[role.form]!} rel="noopener">
                  Sign up<span class="sr-only"> (opens a Google Form)</span>
                </a>
              ) : (
                <span class="btn btn--soon">Opening soon</span>
              )}
            </div>
          </article>
        ))
      }
      <Gate confirmed={site.confirmed.donate && site.confirmed.sop} note="needs D2 + D3">
        <article class="card card--outline">
          <h2 class="h3">Fundraise for the run</h2>
          <p>{copy.fundraising.title}</p>
          <div class="push">
            <a class="btn btn--primary" href={link(variant, 'fundraising')}>Donate</a>
          </div>
        </article>
      </Gate>
    </div>
  </section>

  <section class="sec sec--line">
    <div class="wrap">
      <aside class="note">
        <h2 class="eyebrow">Before you fill in a form</h2>
        <p>Our sign-up forms are Google Forms in Amalia’s account. If you’re under 18, a parent or guardian needs to fill in or sign the consent part. Please leave out health details and anyone else’s personal details.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .title {
    max-width: 18ch;
  }
  .gap-m {
    gap: 20px;
  }
  .self-start {
    align-self: flex-start;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-weight: 700;
  }
  .roles {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
  .card {
    scroll-margin-top: 24px;
  }
  .push {
    margin-top: auto;
  }
  .note {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 860px;
    padding: 22px 24px;
    border: 2px solid var(--navy);
    border-radius: var(--radius);
  }
</style>
