---
import Base from '../../layouts/Base.astro';
import Gate from '../../components/Gate.astro';
import Bib from '../../components/Bib.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import PageHead from '../../components/PageHead.astro';
import { variantPaths, link, type Variant } from '../../lib/variant';
import { copy } from '../../data/copy';
import { wideOnPhone } from '../../lib/pairs';
import { site, showPending, hasSignupRoute } from '../../data/site';

export function getStaticPaths() {
  return variantPaths();
}
const { variant } = Astro.props as { variant: Variant };
const forms = site.forms as Record<string, string | null>;
const donateReady = site.confirmed.donate && site.confirmed.sop;
// Phones pair the short bibs; the Fundraise bib counts only while it shows.
const bibCount = copy.involved.roles.length + (showPending(donateReady) ? 1 : 0);
const wide = wideOnPhone([...copy.involved.roles, ...(showPending(donateReady) ? [{ text: null }] : [])]);
// "Run with us" widens so the rows have no holes.
const span = { three: bibCount % 3 === 2, two: bibCount % 2 === 1 };
---

<Base title="Get involved" description={copy.involved.title} variant={variant} current="involved">
  <PageHead title={copy.involved.title} lead={hasSignupRoute ? copy.involved.formNote : null} />

  <section class="sec" aria-label="Ways to help">
    <div class="wrap bibs">
      {
        copy.involved.roles.map((role, index) => (
          <Bib id={role.id} title={role.title} text={role.text} href={forms[role.form]} run={role.id === 'run'} wide={wide[index]} span={role.id === 'run' ? span : undefined} />
        ))
      }
      <Gate confirmed={donateReady} note="needs D2 + D3">
        <Bib id="fundraise" title="Fundraise" href={site.donateUrl ? link(variant, 'fundraising') : null} label="Donate" />
      </Gate>
    </div>
  </section>

  <Gate confirmed={donateReady} note="needs D2 + D3">
    <section class="sec band-cream" aria-labelledby="fundraise-title">
      <div class="wrap stack">
        <h2 class="h2" id="fundraise-title">Fundraise for the run</h2>
        {
          site.donateUrl ? (
            <a class="btn self-start" href={link(variant, 'fundraising')}>Donate</a>
          ) : (
            <ComingSoon title="The fundraiser opens soon" />
          )
        }
      </div>
    </section>
  </Gate>
</Base>

<style>
  .bibs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-24);
  }
  .bibs > :global(.gate) {
    height: 100%;
  }
  @media (max-width: 1023px) {
    .bibs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 720px) {
    .bibs {
      gap: var(--space-12);
    }
  }
</style>
