---
import Base from '../../layouts/Base.astro';
import Gate from '../../components/Gate.astro';
import Laps from '../../components/Laps.astro';
import { variantPaths, link, type Variant } from '../../lib/variant';
import { countLabel } from '../../lib/count';
import { copy } from '../../data/copy';
import { site, showPending } from '../../data/site';

export function getStaticPaths() {
  return variantPaths();
}
const { variant } = Astro.props as { variant: Variant };
const p = copy.programme;
// "Rooted in Pakistan" is hidden on the live site until SOP confirms, so count what shows.
const principlesLabel = countLabel(p.principles.filter((principle) => !principle.sop || showPending(site.confirmed.sop)).length, 'principles');
---

<Base title="Our Approach" description={p.whoFor} variant={variant} current="approach">
  <section class="sec band-cream">
    <div class="wrap stack gap-m">
      <p class="eyebrow">Our approach · Karachi</p>
      <h1 class="h1 title">{p.title}</h1>
    </div>
  </section>

  <section class="sec">
    <div class="wrap two">
      <div class="stack">
        <p class="eyebrow">Our vision</p>
        <p class="vision">{p.vision}</p>
      </div>
      <div class="stack">
        <p class="eyebrow">Our mission</p>
        <p>{p.mission}</p>
      </div>
    </div>
  </section>

  <section class="sec sec--line">
    <div class="wrap">
      <h2 class="eyebrow list-label">{principlesLabel}</h2>
      <ol class="principles">
        {
          p.principles.map((principle, index) => {
            const row = (
              <li class="principle reveal" data-inview>
                <span class="n">{String(index + 1).padStart(2, '0')}</span>
                <div class="stack gap-s">
                  <h3 class="h3"><span class="mark">{principle.title}</span></h3>
                  <p class="measure">
                    {principle.parts.map((part) =>
                      part.sop ? (
                        <Gate confirmed={site.confirmed.sop} note="needs SOP’s written OK (D2)" inline>
                          {part.text}{' '}
                        </Gate>
                      ) : (
                        <span>{part.text} </span>
                      )
                    )}
                  </p>
                  {principle.modulesLink && <a class="more" href={link(variant, 'impact')}>See the modules</a>}
                </div>
              </li>
            );
            return principle.sop ? (
              <Gate confirmed={site.confirmed.sop} note="partnership claim: needs SOP’s written OK (D2)">
                {row}
              </Gate>
            ) : (
              row
            );
          })
        }
      </ol>
    </div>
  </section>

  <section class="sec sec--line">
    <div class="wrap stack gap-l">
      <p class="eyebrow">How we work</p>
      <h2 class="h2 sessions">{p.sessionsTitle}</h2>
      <Laps />
      <div class="stack how">
        <p class="measure">{p.sessionsText}</p>
        {p.howWeWork.map((line) => <p class="measure">{line}</p>)}
      </div>
    </div>
  </section>

  <section class="sec band-navy on-dark">
    <div class="wrap stack gap-m">
      <p class="eyebrow">Who are we for?</p>
      <p class="who">{p.whoFor}</p>
      <p class="measure">{p.whoForMore}</p>
      <div class="row">
        <a class="btn btn--primary" href={link(variant, 'get-involved#run')}>Join a run</a>
        <a class="btn btn--light" href={link(variant, 'impact')}>See the modules</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .title {
    max-width: 18ch;
  }
  .gap-s {
    gap: 10px;
  }
  .gap-m {
    gap: 20px;
  }
  .gap-l {
    gap: 28px;
  }
  .two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 40px;
  }
  .vision {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.35;
  }
  .list-label {
    margin-bottom: 12px;
  }
  /* The list is a running track: a line runs through the numbered checkpoints
     and fills with raspberry as you scroll down it. */
  .principles {
    --dot: 56px;
    position: relative;
    isolation: isolate;
    view-timeline: --principles block;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .principles::before,
  .principles::after {
    content: '';
    position: absolute;
    top: 48px;
    bottom: 48px;
    left: calc(var(--dot) / 2 - 2px);
    z-index: -1; /* behind the rows: each row's reveal makes its own layer */
    width: 4px;
    border-radius: 4px;
  }
  .principles::before {
    background: var(--navy-100);
  }
  .principles::after {
    background: var(--rasp);
    transform-origin: top;
  }
  @keyframes track-fill {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  /* Browsers without scroll timelines finish this instantly: the line shows full. */
  @media (prefers-reduced-motion: no-preference) {
    /* Longhands on purpose (see the reveal note in global.css). */
    .principles::after {
      animation-name: track-fill;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --principles;
      animation-range: cover 20% cover 70%;
    }
  }
  .principle {
    display: grid;
    grid-template-columns: var(--dot) 1fr;
    gap: 12px 28px;
    padding: 20px 0;
  }
  .principle .n {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--dot);
    height: var(--dot);
    border: 3px solid var(--rasp);
    border-radius: 999px;
    background: var(--white);
    color: var(--rasp);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    transition:
      border-color 0.4s ease,
      color 0.4s ease,
      transform 0.5s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .principle:not(.in-view) .n {
      border-color: var(--navy-200);
      color: var(--navy-700);
      transform: scale(0.82);
    }
  }
  .principle > .stack {
    min-width: 0;
    padding-top: 12px;
  }
  .principle .h3 {
    --mark-delay: 0.25s;
  }
  @media (max-width: 560px) {
    .principles {
      --dot: 44px;
    }
    .principle {
      gap: 10px 16px;
    }
    .principle .n {
      font-size: 17px;
    }
    .principle > .stack {
      padding-top: 6px;
    }
  }
  .more {
    align-self: flex-start;
    padding: 8px 0;
    font-weight: 700;
  }
  .how {
    gap: 14px;
  }
  .sessions {
    max-width: 24ch;
  }
  .who {
    max-width: 46ch;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 600;
    line-height: 1.4;
  }
</style>
