---
import Base from '../../layouts/Base.astro';
import Beats from '../../components/Beats.astro';
import Gate from '../../components/Gate.astro';
import GoalRing from '../../components/GoalRing.astro';
import BibMaker from '../../components/BibMaker.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import Closing from '../../components/Closing.astro';
import Art from '../../components/Art.astro';
import { variantPaths, link, type Variant } from '../../lib/variant';
import { copy } from '../../data/copy';
import { site, showPending } from '../../data/site';

export function getStaticPaths() {
  return variantPaths();
}
const { variant } = Astro.props as { variant: Variant };
const event = site.event;
const donateReady = site.confirmed.sop && site.confirmed.donate;
// "Inaugural 5K"; the venue joins it once the park permit is confirmed.
const eyebrow = event.date ? copy.fiveK.eyebrow : copy.fiveK.eyebrow.split(' · ')[0];
const details = [
  { label: 'Date', value: event.date },
  { label: 'Start time', value: event.startTime ? `${event.startTime} (New York time)` : null },
  { label: 'Start and finish', value: event.startFinish },
].filter((item) => item.value);
// "From Central Park to Pakistan." waits for the permit and both confirmations.
const closingTitle = event.date && donateReady ? 'From Central Park to Pakistan.' : copy.startLine;
---

<Base title="The 5K" description={copy.fiveK.launch} variant={variant} current="5k" ground="rasp">
  <section class="hero band-rasp" aria-labelledby="fivek-title">
    <Art name="hero-track" width={1200} height={520} eager class="hero-art" />
    <div class="wrap hero-in">
      <div class="stack-m">
        <p class="eyebrow">{eyebrow}</p>
        <Beats id="fivek-title" still />
        <p class="lead hero-lead">{copy.fiveK.launch}</p>
      </div>
      <p class="wordmark" role="img" aria-label="Soles with Goals">
        <span aria-hidden="true">S<GoalRing tone="raspberry" size={40} class="o" />LES</span>
        <span aria-hidden="true"><em>with</em> G<GoalRing tone="raspberry" size={40} class="o" />ALS</span>
      </p>
    </div>
  </section>

  <section class="when" aria-label="Date and registration">
    <div class="wrap">
      {
        event.date ? (
          <div class="facts">
            <dl>
              {details.map((item) => (
                <div class="fact">
                  <dt class="eyebrow">{item.label}</dt>
                  <dd class="h4">{item.value}</dd>
                </div>
              ))}
            </dl>
            {event.registerUrl && (
              <a class="btn self-start" href={event.registerUrl} rel="noopener">
                Register
              </a>
            )}
          </div>
        ) : (
          <ComingSoon
            title="Date coming soon"
            text="We’ll share the date, start time and start point as soon as the park permit is confirmed."
          />
        )
      }
    </div>
  </section>

  <section class="sec band-cream" aria-labelledby="for-title">
    <div class="wrap stack">
      <h2 class="h2" id="for-title">Who it’s for</h2>
      <div class="stack-s measure">
        <ul class="modes">
          {
            (['icon-walk', 'icon-wheel', 'icon-run'] as const).map((icon, index) => (
              <li>
                <Art name={icon} width={64} height={64} />
                <span class="h4">{copy.fiveK.title[index]}</span>
              </li>
            ))
          }
        </ul>
        <p class="lead">{copy.positioning}</p>
        <p class="body">
          {copy.positioningUnlike}<Gate confirmed={site.confirmed.sop} note="needs SOP’s written OK (D2)" inline>{copy.positioningSop}</Gate>.
        </p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="goal-title">
    <div class="wrap goal">
      <div class="stack-m goal-text">
        <h2 class="h2" id="goal-title">{copy.fiveK.goalTitle}</h2>
        <p class="lead body">{copy.fiveK.goalText}</p>
      </div>
      <BibMaker />
    </div>
  </section>

  <section class="sec band-cream" aria-labelledby="course-title">
    <div class="wrap stack">
      <h2 class="h2" id="course-title">The course</h2>
      <ComingSoon
        title="Course details coming soon"
        text="Once the route is confirmed, you’ll find the course map, the surface, wheelchair access and a quiet spot right here."
      >
        <Art slot="art" name="route-5k" width={600} height={360} class="route" />
      </ComingSoon>
    </div>
  </section>

  <Closing title={closingTitle}>
    <a class="btn btn--on-rasp" href={link(variant, 'get-involved')}>Get involved</a>
    {
      showPending(donateReady) && (
        <Gate confirmed={donateReady} note="needs D2 + D3">
          <a class="btn btn--outline-light" href={link(variant, 'fundraising')}>Fundraising</a>
        </Gate>
      )
    }
  </Closing>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  /* Track lanes from her brand set, in the band's empty right half. */
  .hero :global(.hero-art) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(820px, 58vw);
  }
  .hero-in {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-64);
    padding-top: var(--space-32);
    padding-bottom: clamp(64px, 6.67vw, 96px);
  }
  /* Her alternate wordmark from the logo system: Goal Rings for the O's. */
  .wordmark {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    align-self: start;
    font-family: var(--font-display);
    font-size: var(--display-l);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .wordmark em {
    font-family: var(--font-body);
    font-weight: 400;
    letter-spacing: 0;
  }
  .wordmark :global(.o) {
    display: inline-block;
    width: 0.78em;
    height: 0.78em;
    vertical-align: -0.04em;
  }
  .modes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16) var(--space-32);
    margin: 0 0 var(--space-8);
    padding: 0;
    list-style: none;
  }
  .modes li {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }
  .modes .h4 {
    font-family: var(--font-display);
  }
  @media (max-width: 560px) {
    .modes {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-12);
    }
    .modes li {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-8);
    }
  }
  .stack :global(.route) {
    width: min(600px, 100%);
  }
  @media (max-width: 860px) {
    .hero-in {
      grid-template-columns: 1fr;
      padding-bottom: calc(43vw + var(--space-16));
    }
    .hero :global(.hero-art) {
      width: 100%;
    }
    .wordmark {
      display: none;
    }
  }
  .hero-lead {
    max-width: 640px;
  }
  .when {
    padding: var(--space-48) 0;
  }
  .facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    padding: var(--space-32);
    border: 1px solid var(--navy-100);
    border-radius: var(--radius);
  }
  .facts dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-24);
    margin: 0;
  }
  .fact dd {
    margin: 4px 0 0;
    font-family: var(--font-display);
  }
  .goal {
    display: grid;
    grid-template-columns: 1fr minmax(0, 520px);
    align-items: center;
    gap: var(--space-64);
  }
  .goal-text {
    min-width: 0;
  }
  @media (max-width: 860px) {
    .goal {
      grid-template-columns: 1fr;
      gap: var(--space-32);
    }
  }
</style>
