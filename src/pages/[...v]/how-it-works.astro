---
// Our approach and the modules on one page, with anchors at the top.
// /approach and /impact point here.
import Base from '../../layouts/Base.astro';
import Gate from '../../components/Gate.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import PageHead from '../../components/PageHead.astro';
import SubTabs from '../../components/SubTabs.astro';
import { variantPaths, type Variant } from '../../lib/variant';
import { countLabel } from '../../lib/count';
import { copy } from '../../data/copy';
import { site, showPending } from '../../data/site';

export function getStaticPaths() {
  return variantPaths();
}
const { variant } = Astro.props as { variant: Variant };
const p = copy.programme;
const i = copy.impact;
const first = i.modules[0];
// "Rooted in Pakistan" is hidden on the live site until SOP confirms, so count what shows.
const principlesLabel = countLabel(p.principles.filter((principle) => !principle.sop || showPending(site.confirmed.sop)).length, 'principles');
// Only resources that exist or have a date to show.
const resources = i.resources.filter((resource) => resource.file || resource.status);
const anyFile = i.resources.some((resource) => resource.file);
const tabs = [
  { id: 'approach', label: 'Our approach' },
  { id: 'sessions', label: 'Sessions' },
  { id: 'modules', label: 'Modules' },
  { id: 'resources', label: 'Resources' },
];
---

<Base title="How it works" description={p.whoFor} variant={variant} current="how" ground="rasp">
  <PageHead title={p.title} lead={p.vision} />
  <SubTabs items={tabs} />

  <section id="approach" class="sec target" aria-labelledby="approach-title">
    <div class="wrap stack">
      <h2 class="h2" id="approach-title">{principlesLabel}</h2>
      <ul class="principles">
        {
          p.principles.map((principle) => {
            // A principle waiting for SOP's written OK: outlined in the review build, left out live.
            const pending = Boolean(principle.sop) && !site.confirmed.sop;
            if (pending && !site.review) return null;
            return (
              <li
                class:list={['principle', { gate: pending }]}
                data-note={pending ? 'partnership claim: needs SOP’s written OK (D2)' : undefined}
              >
                <h3 class="h4">{principle.title}</h3>
                <div class="stack-s">
                  <p class="body">
                    {principle.parts.map((part) =>
                      'sop' in part && part.sop ? (
                        <Gate confirmed={site.confirmed.sop} note="needs SOP’s written OK (D2)" inline>
                          {part.text}{' '}
                        </Gate>
                      ) : (
                        <span>{part.text} </span>
                      )
                    )}
                  </p>
                  {principle.modulesLink && <a class="more" href="#modules">See the modules</a>}
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section id="sessions" class="sec band-navy target" aria-labelledby="sessions-title">
    <div class="wrap stack">
      <h2 class="h2" id="sessions-title">{p.sessionsTitle}</h2>
      <!-- One drawn lap with a mark for each part of the week's session; a vertical lane on phones. -->
      <ol class="lap">
        {
          p.sessions.map((part, index) => (
            <li class="lap-step">
              <span class="lap-mark" aria-hidden="true" />
              <span class="badge">Step {index + 1}</span>
              <span class="h3 lap-name">{part}</span>
            </li>
          ))
        }
      </ol>
      <div class="stack-s measure work">
        <p class="lead body">{p.sessionsText}</p>
        {p.howWeWork.map((line) => <p class="body">{line}</p>)}
      </div>
    </div>
  </section>

  <section id="modules" class="sec target" aria-labelledby="modules-title">
    <div class="wrap stack">
      <div class="peek">
        <ComingSoon title="Module 1 preview coming soon" text="A sneak peek at the first slides of Module 1." />
        <div class="stack-m peek-text">
          <p class="eyebrow">Module 1 sneak peek</p>
          <h2 class="h2" id="modules-title">{first.title}</h2>
          <span class="btn btn--soon self-start">Opening soon</span>
        </div>
      </div>
      <h3 class="h3">All {countLabel(i.modules.length, 'modules').toLowerCase()}</h3>
      <ol class="rows modules">
        {
          i.modules.map((module) => (
            <li class="module">
              <span class="h4">{module.title}</span>
              {module.text && <p class="body">{module.text}</p>}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="resources" class="sec band-cream target" aria-labelledby="resources-title">
    <div class="wrap stack">
      <h2 class="h2" id="resources-title">Resources</h2>
      <p class="lead body measure">{i.resourcesTitle}</p>
      <ul class="resources">
        {
          resources.map((resource) => (
            <li class="resource">
              <span class="h4">{resource.title}</span>
              {resource.file ? (
                <a class="btn" href={resource.file} download>
                  Download<span class="sr-only"> {resource.title}</span>
                </a>
              ) : (
                <span class="status">{resource.status}</span>
              )}
            </li>
          ))
        }
      </ul>
      {
        anyFile && (
          <div class="stack-s measure">
            <h3 class="h4">{i.coachTitle}</h3>
            <p class="body">{i.coachText}</p>
          </div>
        )
      }
      <p class="small measure">
        <strong>Health note:</strong> These guides are for learning only. They aren’t medical advice and can’t replace a doctor or nurse. In an emergency,
        call emergency services.
      </p>
    </div>
  </section>
</Base>

<style>
  /* Short paragraphs: even line lengths from tablet up, so no two-word last line
     ("the team."); phones keep pretty wrapping (balance stops at six lines). */
  @media (min-width: 600px) {
    .work p {
      text-wrap: balance;
    }
  }
  .target {
    scroll-margin-top: var(--tabs-h);
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows > :global(*) {
    border-top: 1px solid var(--navy-100);
  }
  /* Principles aren't a sequence: title over text, two to a row. */
  .principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-48) var(--space-64);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .principle {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    max-width: min(640px, 31em);
  }
  .more {
    align-self: flex-start;
    padding: 10px 0;
    font-weight: 700;
  }
  /* The weekly lap: a running track drawn in her lane colours (solid outer
     lane, dashed inner lane, as in Home's art), the four parts as marks on
     its top straight, each name under its mark. Badges and names share rows
     across the lap, so the names start on one line. */
  .lap {
    --mark: 24px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: auto auto;
    column-gap: var(--space-24);
    row-gap: var(--space-12);
    margin: 0;
    padding: var(--space-48) clamp(48px, 6vw, 96px) var(--space-64);
    list-style: none;
  }
  .lap::before,
  .lap::after {
    content: '';
    position: absolute;
    border-radius: var(--radius-pill);
    pointer-events: none;
  }
  .lap::before {
    inset: 0;
    border: 4px solid rgb(255 255 255 / 0.35);
  }
  .lap::after {
    inset: 14px;
    border: 2px dashed rgb(255 255 255 / 0.5);
  }
  .lap-step {
    position: relative;
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    justify-items: center;
    text-align: center;
  }
  .lap-mark {
    position: absolute;
    top: calc(-1 * var(--space-48) - var(--mark) / 2 + 2px);
    left: 50%;
    width: var(--mark);
    height: var(--mark);
    translate: -50% 0;
    border: 4px solid var(--navy);
    border-radius: 50%;
    background: var(--aqua);
  }
  .lap-name {
    color: var(--white);
  }
  .badge,
  .status {
    display: inline-flex;
    padding: var(--space-4) var(--space-12);
    border-radius: var(--radius-pill);
    background: var(--aqua);
    color: var(--navy);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .h4 {
    font-family: var(--font-display);
  }
  .peek {
    display: grid;
    grid-template-columns: minmax(0, 620px) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-64);
  }
  .peek-text {
    min-width: 0;
  }
  .module {
    padding: var(--space-16) 0;
  }
  .resources {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .resource {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12) var(--space-24);
  }

  /* Tablets: a wider lap so the four names keep their words together. */
  @media (max-width: 1023px) {
    .lap {
      column-gap: var(--space-12);
      padding-inline: var(--space-24);
    }
  }
  @media (max-width: 860px) {
    .peek {
      grid-template-columns: 1fr;
      gap: var(--space-32);
    }
  }
  @media (max-width: 720px) {
    .principles {
      grid-template-columns: 1fr;
      gap: var(--space-32);
    }
    /* Phones: the lap runs as one vertical lane, marks on the line. */
    .lap {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      row-gap: var(--space-32);
      padding: var(--space-8) 0 var(--space-8) var(--space-48);
    }
    .lap::before {
      inset: 0 auto 0 10px;
      width: 0;
      border: 0;
      border-left: 4px solid rgb(255 255 255 / 0.35);
      border-radius: 0;
    }
    .lap::after {
      display: none;
    }
    .lap-step {
      grid-row: auto;
      grid-template-rows: none;
      justify-items: start;
      gap: var(--space-8);
      text-align: start;
    }
    .lap-mark {
      top: 0;
      left: calc(-1 * var(--space-48) + 12px);
    }
    .resource {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
