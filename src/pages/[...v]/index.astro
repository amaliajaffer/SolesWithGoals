---
import Base from '../../layouts/Base.astro';
import Beats from '../../components/Beats.astro';
import TrackMedia from '../../components/TrackMedia.astro';
import Gate from '../../components/Gate.astro';
import Bib from '../../components/Bib.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import Closing from '../../components/Closing.astro';
import Art from '../../components/Art.astro';
import { variantPaths, link, type Variant } from '../../lib/variant';
import { countLabel } from '../../lib/count';
import { wideOnPhone } from '../../lib/pairs';
import { copy } from '../../data/copy';
import { site, showPending } from '../../data/site';

export function getStaticPaths() {
  return variantPaths();
}
const { variant } = Astro.props as { variant: Variant };
const photos = variant === 'photos';
const forms = site.forms as Record<string, string | null>;
const donateReady = site.confirmed.donate && site.confirmed.sop;
// Phones pair the short bibs; the Fundraise bib counts only while it shows.
const bibCount = copy.involved.roles.length + (showPending(donateReady) ? 1 : 0);
const wide = wideOnPhone([...copy.involved.roles, ...(showPending(donateReady) ? [{ text: null }] : [])]);
// "Run with us" widens so the rows have no holes.
const span = { three: bibCount % 3 === 2, two: bibCount % 2 === 1 };
// The fourth pillar is hidden on the live site until SOP confirms, so count what shows.
const pillarCount = copy.pillars.filter((pillar) => !pillar.sop || showPending(site.confirmed.sop && Boolean(site.event.date))).length;
const [statement, ...rest] = copy.stories.who;
// The fourth pillar names Central Park, so it also waits for the park permit (the event date).
const sopAndVenue = site.confirmed.sop && Boolean(site.event.date);
---

<Base description={copy.introLine} variant={variant} ground="rasp">
  <section class:list={['hero', 'band-rasp', { 'hero--poster': !photos }]} aria-labelledby="hero-title">
    <Art name="hero-track" width={1200} height={520} eager class="hero-art" />
    <div class="wrap hero-row">
      <div class="hero-text stack">
        <Beats id="hero-title" poster={!photos} />
        <p class="lead hero-lead">{copy.essence} {copy.introLine}</p>
        <div class="row">
          <a class="btn btn--on-rasp" href={link(variant, 'get-involved')}>Get involved</a>
          <a class="btn btn--outline-light" href={link(variant, 'the-5k')}>See the 5K</a>
        </div>
      </div>
      {photos && <TrackMedia id="hero-clip" eager class="hero-media" />}
    </div>
  </section>

  <section class="sec" aria-labelledby="who-title">
    <div class="wrap stack">
      <h2 class="h3" id="who-title">Who we’re running for</h2>
      <div class="problem">
        <p class="lead statement">{statement}</p>
        <div class="stack-s">{rest.map((paragraph) => <p class="lead body">{paragraph}</p>)}</div>
      </div>
    </div>
  </section>

  <section class="sec band-cream" aria-labelledby="do-title">
    <div class="wrap stack">
      <div class="do-head">
        <h2 class="h2" id="do-title">What we do</h2>
        <Art name="soles-stride" width={360} height={300} class="do-art" />
      </div>
      <div class="features">
        <article class="feature feature--navy band-navy">
          <h3 class="h3">{copy.programme.teaserTitle}</h3>
          <p class="body">{copy.programme.teaser}</p>
          <a class="btn" href={link(variant, 'how-it-works')}>How it works</a>
        </article>
        <article class="feature">
          <h3 class="h3">The Soles with Goals 5K</h3>
          <p class="body">{copy.fiveK.launch}</p>
          <a class="btn btn--outline" href={link(variant, 'the-5k')}>See the 5K</a>
        </article>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="pillars-title">
    <div class="wrap">
      <h2 class="sr-only" id="pillars-title">{countLabel(pillarCount, 'pillars')}</h2>
      <div class="pillars">
        {
          copy.pillars.map((pillar) => {
            const item = (
              <div class="pillar">
                <h3 class="h4">{pillar.title}</h3>
                <p class="body">{pillar.text}</p>
              </div>
            );
            return pillar.sop ? (
              <Gate confirmed={sopAndVenue} note="needs SOP’s written OK (D2) and the park permit">
                {item}
              </Gate>
            ) : (
              item
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="sec band-cream" aria-labelledby="help-title">
    <div class="wrap stack">
      <h2 class="h2" id="help-title">{copy.involved.title}</h2>
      <p class="body measure">{copy.involved.formNote}</p>
      <div class="bibs">
        {
          copy.involved.roles.map((role, index) => (
            <Bib title={role.title} text={role.text} href={forms[role.form]} run={role.id === 'run'} wide={wide[index]} span={role.id === 'run' ? span : undefined} />
          ))
        }
        <Gate confirmed={donateReady} note="needs D2 + D3">
          <Bib title="Fundraise" href={site.donateUrl ? link(variant, 'fundraising') : null} label="Donate" />
        </Gate>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="why-title">
    <div class="wrap stack">
      <div class="story">
        {
          photos && (
            <figure class="story-media">
              <img src="/media/stadium.jpg" width="640" height="957" loading="lazy" decoding="async" alt="Amalia racing on an outdoor track" />
            </figure>
          )
        }
        <div class:list={['stack-m', 'story-text', { 'story-text--full': !photos }]}>
          <h2 class="eyebrow" id="why-title">Why I run</h2>
          <blockquote class="stack-m">
            <p class="quote">{copy.essay.quote}</p>
            <footer class="small">{copy.essay.byline}</footer>
          </blockquote>
          <a class="btn btn--outline self-start" href={link(variant, 'stories#why-i-run')}>Read “Why I run”</a>
        </div>
      </div>
      <ComingSoon title={copy.stories.title} />
    </div>
  </section>

  <Closing title={copy.startLine}>
    <a class="btn btn--on-rasp" href={link(variant, 'get-involved')}>Get involved</a>
    <a class="btn btn--outline-light" href={link(variant, 'contact')}>Contact</a>
  </Closing>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  /* Track lanes from her brand set, in the band's empty bottom-right corner. */
  .hero :global(.hero-art) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(760px, 54vw);
  }
  .hero-row {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-64);
    padding-top: var(--space-64);
    padding-bottom: var(--space-64);
  }
  .hero-text {
    flex: 1 1 0;
    min-width: 0;
  }
  .hero-lead {
    max-width: 620px;
  }
  .hero :global(.hero-media) {
    flex: 0 0 min(560px, 42%);
    aspect-ratio: 14 / 9;
  }
  .statement {
    font-weight: 700;
  }
  .problem {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-64);
  }
  .features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-32);
  }
  .feature {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
    padding: clamp(24px, 3.34vw, 48px);
    border: 1px solid var(--navy-100);
    border-radius: var(--radius);
    background: var(--white);
  }
  .feature--navy {
    border-color: var(--navy);
    background: var(--navy);
  }
  .feature .btn {
    margin-top: auto;
  }
  .feature .body {
    margin-bottom: var(--space-8);
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-48) var(--space-32);
  }
  .pillar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-12);
    max-width: 400px;
  }
  .bibs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-24);
  }
  .bibs > :global(.gate) {
    height: 100%;
  }
  .story {
    display: flex;
    align-items: center;
    gap: var(--space-64);
  }
  .story-media {
    position: relative;
    display: grid;
    flex: 0 0 min(480px, 40%);
    place-items: center;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--aqua);
  }
  .story-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .story-text {
    flex: 1 1 0;
    min-width: 0;
    max-width: 860px;
  }
  /* Without her photo the quote runs the full width as a pull line. */
  .story-text--full {
    max-width: none;
  }
  .story-text--full .quote {
    font-size: var(--display-l);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  /* Without her clip the launch post fills the band at poster size. */
  .hero--poster .hero-row {
    padding-top: var(--space-48);
    padding-bottom: var(--space-128);
  }
  .do-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-32);
  }
  .do-head :global(.do-art) {
    width: clamp(160px, 16vw, 240px);
    margin-bottom: calc(var(--space-32) * -1);
  }
  .hero--poster .hero-lead {
    max-width: 640px;
  }
  @media (max-width: 1023px) {
    .bibs {
      grid-template-columns: repeat(2, 1fr);
    }
    .pillars {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 860px) {
    /* Phones: the lanes sit under the buttons, at the full width of the band. */
    .hero :global(.hero-art) {
      width: 100%;
    }
    .hero--poster .hero-row {
      padding-bottom: calc(43vw + var(--space-16));
    }
    .hero-row {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-32);
      padding-top: var(--space-32);
      padding-bottom: var(--space-48);
    }
    .hero :global(.hero-media) {
      flex: none;
      width: 100%;
    }
    .story {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-24);
    }
    .story-media {
      flex: none;
      width: 100%;
    }
  }
  @media (max-width: 720px) {
    .do-head :global(.do-art) {
      display: none;
    }
    .problem,
    .features,
    .pillars {
      grid-template-columns: 1fr;
    }
    .bibs {
      gap: var(--space-12);
    }
    .problem {
      gap: var(--space-16);
    }
    .pillars {
      gap: var(--space-32);
    }
  }
</style>
