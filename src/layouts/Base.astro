---
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css';
// Bricolage stays only for her wordmark (Logo.astro).
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReviewBar from '../components/ReviewBar.astro';
import { site } from '../data/site';
import type { Variant } from '../lib/variant';

interface Props {
  title?: string;
  description: string;
  variant: Variant;
  current?: string;
  // Raspberry header on Home and The 5K, white elsewhere.
  ground?: 'white' | 'rasp';
}
const { title, description, variant, current, ground = 'white' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Every pace counts`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Share cards need absolute image URLs; without a domain yet, fall back to the path.
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const shareImage = absolute('/og-image.png');
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  slogan: 'Every pace counts.',
  logo: absolute('/apple-touch-icon.png'),
  ...(Astro.site ? { url: Astro.site.href } : {}),
  ...(site.socials.length ? { sameAs: site.socials.map((social) => social.url) } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {site.review && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={ground === 'rasp' ? '#DC0F5E' : '#FFFFFF'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Soles with Goals: Every pace counts." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
    <!-- Before first paint: lets CSS hold scroll-triggered animations until seen. Without JS everything shows. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class:list={{ 'ground-rasp': ground === 'rasp' }}>
    <a class="skip" href="#main">Skip to content</a>
    <Header variant={variant} current={current} ground={ground} />
    <main id="main">
      <slot />
    </main>
    <Footer variant={variant} />
    {site.review && <ReviewBar variant={variant} />}
    <script>
      import '../scripts/inview';
    </script>
  </body>
</html>
