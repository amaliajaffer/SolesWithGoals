---
// The top of About "begins with video" (her intake). The documentary plays here
// once site.film is set (clips after her December trip). Until then the photos
// version shows her running clip and the plain version says
// the film is coming.
// Her media lives in /media (not imported), so a build without the photos
// version never ships it; astro.config copies only files a page links to.
import ComingSoon from './ComingSoon.astro';
import PauseButton from './PauseButton.astro';
import { site } from '../data/site';
import type { Variant } from '../lib/variant';

interface Props {
  variant: Variant;
}
const { variant } = Astro.props;
const film = site.film;
---

{
  film ? (
    <figure class="frame frame--video">
      <iframe
        src={film.embedUrl}
        title={film.title}
        loading="lazy"
        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
        allowfullscreen
      />
      {film.note && <figcaption class="small">{film.note}</figcaption>}
    </figure>
  ) : variant === 'photos' ? (
    <figure class="frame frame--clip" id="story-clip">
      <picture>
        <source media="(prefers-reduced-motion: reduce)" srcset="/media/story-still.jpg" />
        <img class="clip-anim" src="/media/story-loop.webp" width="720" height="540" alt="" decoding="async" />
      </picture>
      <img class="clip-still" src="/media/story-still.jpg" width="720" height="540" decoding="async" loading="eager" alt="Amalia running through a park" />
      <PauseButton target="story-clip" label="the opening clip" class="clip-pause" />
    </figure>
  ) : (
    <ComingSoon title="Amalia’s film is coming in December" text="Clips from her documentary will play right here." />
  )
}

<style>
  .frame {
    position: relative;
    width: 100%;
    margin: 0;
    aspect-ratio: 1312 / 420;
    overflow: hidden;
    border-radius: var(--radius);
    border-top-left-radius: var(--bend);
    background: var(--navy);
  }
  .frame img,
  .frame :global(img),
  .frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .frame :global(.clip-pause) {
    position: absolute;
    bottom: var(--space-24);
    left: 50%;
    z-index: 2;
    translate: -50% 0;
  }
  /* Her clip is 720 px wide: shown at its own size so it stays sharp. */
  .frame--clip {
    max-width: 720px;
    aspect-ratio: 14 / 9;
  }
  .frame--video {
    aspect-ratio: 16 / 9;
    overflow: visible;
    border-radius: var(--radius);
  }
  .frame--video iframe {
    border-radius: var(--radius);
  }
  .frame--video figcaption {
    position: absolute;
    top: calc(100% + 10px);
  }
  @media (max-width: 760px) {
    .frame--clip {
      max-width: none;
    }
  }
</style>
