---
// The top of About "begins with video" (her intake). The documentary plays here
// once site.film is set (clips after her December trip). Until then the photos
// version shows her running clip and the plain version says the film is coming.
import { Image } from 'astro:assets';
import GoalRing from './GoalRing.astro';
import PauseButton from './PauseButton.astro';
import storyStill from '../assets/photos/story-still.jpg';
import { site } from '../data/site';
import type { Variant } from '../lib/variant';

interface Props {
  variant: Variant;
}
const { variant } = Astro.props;
const film = site.film;
---

<section class="film" aria-label="Film">
  <div class="wrap">
    {
      film ? (
        <figure class="frame frame--video">
          <iframe
            src={film.embedUrl}
            title={film.title}
            loading="lazy"
            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
            allowfullscreen
          />
          {film.note && <figcaption class="small">{film.note}</figcaption>}
        </figure>
      ) : variant === 'photos' ? (
        <figure class="frame frame--clip" id="story-clip">
          <img class="clip-anim" src="/media/story-loop.webp" width="720" height="540" alt="" decoding="async" />
          <Image class="clip-still" src={storyStill} widths={[480, 720]} sizes="(max-width: 760px) 92vw, 720px" loading="eager" alt="Amalia running through a park" />
          <PauseButton target="story-clip" label="Pause the running clip" class="clip-pause" />
        </figure>
      ) : (
        <div class="frame frame--soon">
          <GoalRing tone="reversed" size={120} draw />
          <div class="soon-text">
            <p class="h3">Amalia’s film is coming in December</p>
            <p>Clips from her documentary will play right here.</p>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .film {
    padding-bottom: clamp(32px, 5vw, 56px);
  }
  .frame {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 28px;
    background: var(--navy);
  }
  .frame img,
  .frame :global(img),
  .frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .frame :global(.clip-pause) {
    position: absolute;
    bottom: 16px;
    left: 16px;
    z-index: 2;
  }
  /* Her running clip is 720 px wide: shown at its own size so it stays sharp. */
  .frame--clip {
    max-width: 720px;
    aspect-ratio: 4 / 3;
  }
  .frame--video {
    overflow: visible;
  }
  .frame--video iframe {
    border-radius: 28px;
  }
  .frame--video figcaption {
    position: absolute;
    top: calc(100% + 10px);
  }
  .frame--soon {
    aspect-ratio: auto;
    min-height: 260px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px 36px;
    padding: 32px;
    color: var(--cream);
    text-align: left;
  }
  .soon-text {
    max-width: 30ch;
  }
  .soon-text p + p {
    margin-top: 8px;
    color: var(--navy-100);
  }
  @media (max-width: 560px) {
    .frame--soon {
      text-align: center;
    }
  }
</style>
