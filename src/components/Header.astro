---
import Logo from './Logo.astro';
import { link, type Variant } from '../lib/variant';
import { site, showPending } from '../data/site';

interface Props {
  variant: Variant;
  current?: string;
  ground?: 'white' | 'rasp';
}
const { variant, current, ground = 'white' } = Astro.props;
const rasp = ground === 'rasp';

// Fundraising shows once SOP and the fundraiser are confirmed (outlined in the review build).
const donateReady = site.confirmed.donate && site.confirmed.sop;
const showDonate = showPending(donateReady);
const donate = { key: 'donate', label: 'Fundraising', path: 'fundraising', gate: !donateReady };

type Item = { key: string; label: string; path: string; gate?: boolean };
const main: Item[] = [
  { key: 'about', label: 'About', path: 'about' },
  { key: 'how', label: 'How it works', path: 'how-it-works' },
  { key: '5k', label: 'The 5K', path: 'the-5k' },
  { key: 'stories', label: 'Stories', path: 'stories' },
  ...(showDonate ? [donate] : []),
  { key: 'contact', label: 'Contact', path: 'contact' },
];
const involved: Item = { key: 'involved', label: 'Get involved', path: 'get-involved' };
// The phone menu lists every page.
const menu: Item[] = [...main.slice(0, 4), involved, ...(showDonate ? [donate] : []), main[main.length - 1]];
---

<header class:list={['site-header', { 'site-header--rasp': rasp }]}>
  <div class="wrap bar">
    <a class="home" href={link(variant, '/')} aria-label="Soles with Goals, home"><Logo tone={rasp ? 'raspberry' : 'primary'} /></a>
    <nav class="nav" aria-label="Main">
      <ul>
        {
          main.map((item) => (
            <li>
              <a
                class:list={['nav-link', { gate: item.gate }]}
                data-note={item.gate ? 'needs D2 + D3' : undefined}
                href={link(variant, item.path)}
                aria-current={current === item.key ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        class:list={['btn', { 'btn--on-rasp': rasp }]}
        href={link(variant, involved.path)}
        aria-current={current === involved.key ? 'page' : undefined}
      >
        {involved.label}
      </a>
    </nav>
    <div class="phone">
      <a class="nav-link" href={link(variant, 'contact')} aria-current={current === 'contact' ? 'page' : undefined}>Contact</a>
      <button
        class:list={['btn', 'menu-btn', rasp ? 'btn--outline-light' : 'btn--outline']}
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="i-open">Menu</span><span class="i-close">Close</span>
      </button>
    </div>
  </div>
  <nav id="site-menu" class="panel" aria-label="Menu" hidden>
    <ul class="wrap">
      {
        menu.map((item, index) => (
          <li style={`--i: ${index}`}>
            <a
              class:list={{ gate: item.gate }}
              data-note={item.gate ? 'needs D2 + D3' : undefined}
              href={link(variant, item.path)}
              aria-current={current === item.key ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-btn');
  const panel = document.getElementById('site-menu');
  const setOpen = (open: boolean) => {
    button?.setAttribute('aria-expanded', String(open));
    if (panel) panel.hidden = !open;
  };
  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--white);
    color: var(--navy);
  }
  .site-header--rasp {
    background: var(--rasp);
    color: var(--white);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 80px;
  }
  .home {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    flex-shrink: 0;
    text-decoration: none;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .panel ul {
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-32);
  }
  .nav ul {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.25vw, 32px);
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    background: linear-gradient(currentColor, currentColor) left calc(100% - 6px) / 0 2px no-repeat;
    transition: background-size 0.25s ease;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: inherit;
    background-size: 100% 2px;
  }
  /* Review build: the note sits under the link, since the header is at the top edge. */
  .nav-link.gate::before {
    top: auto;
    right: 0;
    bottom: -14px;
  }
  .phone {
    display: none;
    align-items: center;
    gap: var(--space-16);
  }
  .menu-btn {
    min-width: 88px;
  }
  .i-close,
  .menu-btn[aria-expanded='true'] .i-open {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .i-close {
    display: inline;
  }
  .panel {
    border-top: 1px solid var(--navy-100);
    background: var(--white);
    padding: 4px 0 20px;
  }
  .panel a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    border-bottom: 1px solid var(--navy-100);
    color: var(--navy);
    font-size: 18px;
    text-decoration: none;
  }
  .panel a[aria-current='page'] {
    font-weight: 700;
  }
  .panel a[aria-current='page']::after {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--rasp);
  }
  .panel :focus-visible {
    outline-color: var(--rasp-text);
  }
  /* The menu drops open and its links follow one after another. */
  @keyframes menu-open {
    from {
      opacity: 0;
      translate: 0 -8px;
    }
  }
  @keyframes menu-link {
    from {
      opacity: 0;
      translate: -12px 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .panel:not([hidden]) {
      animation: menu-open 0.25s ease both;
    }
    .panel:not([hidden]) li {
      animation: menu-link 0.32s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--i, 0) * 35ms + 60ms);
    }
  }
  @media (max-width: 999px) {
    .nav {
      display: none;
    }
    .phone {
      display: flex;
    }
  }
  @media (max-width: 359px) {
    .phone {
      gap: var(--space-8);
    }
    .menu-btn {
      min-width: 0;
      padding-inline: 14px;
    }
  }
  @media (min-width: 1000px) {
    .panel {
      display: none !important;
    }
  }
</style>
