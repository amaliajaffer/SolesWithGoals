---
import GoalRing from './GoalRing.astro';
import { link, type Variant } from '../lib/variant';
import { site, showPending } from '../data/site';

interface Props {
  variant: Variant;
}
const { variant } = Astro.props;
const donateReady = site.confirmed.donate && site.confirmed.sop;
type Item = { label: string; path: string; gate?: boolean };
const columns: Item[][] = [
  [
    { label: 'About', path: 'about' },
    { label: 'How it works', path: 'how-it-works' },
    { label: 'The 5K', path: 'the-5k' },
    { label: 'Stories', path: 'stories' },
  ],
  [
    { label: 'Get involved', path: 'get-involved' },
    ...(showPending(donateReady) ? [{ label: 'Fundraising', path: 'fundraising', gate: !donateReady }] : []),
    { label: 'Contact', path: 'contact' },
    { label: 'Privacy', path: 'privacy' },
  ],
];
---

<footer class="footer band-navy">
  <div class="wrap inner">
    <div class="cols">
      <div class="brand">
        <GoalRing tone="reversed" size={56} label="Soles with Goals" />
        <p class="tag">{site.hashtag}</p>
        {site.socials.length > 0 && (
          <ul class="socials">
            {site.socials.map((social) => <li><a href={social.url} rel="noopener">{social.label}</a></li>)}
          </ul>
        )}
      </div>
      <nav class="links" aria-label="Footer">
        {
          columns.map((column) => (
            <ul>
              {column.map((item) => (
                <li>
                  <a class:list={{ gate: item.gate }} data-note={item.gate ? 'needs D2 + D3' : undefined} href={link(variant, item.path)}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </nav>
    </div>
    {!site.confirmed.sop && <p class="fine">We’re a student-led community, and we’re not affiliated with Special Olympics.</p>}
    <p class="fine">© 2026 Soles with Goals</p>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-64) 0;
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-24) var(--space-96);
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  .tag {
    color: var(--aqua);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-24) var(--space-96);
  }
  ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--white);
    font-size: 18px;
    line-height: 1.6;
    text-decoration: none;
  }
  li a:hover {
    color: var(--aqua);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* Review build: the note sits beside the link so it doesn't cover the one above. */
  li .gate::before {
    top: 50%;
    right: auto;
    left: calc(100% + 12px);
    translate: 0 -50%;
  }
  .socials a {
    font-size: 15px;
  }
  .fine {
    color: var(--navy-100);
    font-size: 15px;
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .cols,
    .links {
      flex-direction: column;
    }
  }
</style>
