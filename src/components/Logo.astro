---
// Horizontal lockup: ring + "Soles / with Goals" (Bricolage ExtraBold with
// Atkinson Hyperlegible Next Italic), as in her logo system. On raspberry the arcs
// and dots turn white and the dot turns navy.
import GoalRing from './GoalRing.astro';

interface Props {
  tone?: 'primary' | 'raspberry' | 'dark';
  size?: number;
}
const { tone = 'primary', size = 40 } = Astro.props;
const ring = tone === 'dark' ? 'reversed' : tone;
---

<span class:list={['logo', `logo--${tone}`]}>
  <GoalRing tone={ring} size={size} />
  <span class="wordmark">
    <span>Soles</span>
    <span><em>with</em> Goals</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--navy);
  }
  .logo--raspberry {
    color: var(--white);
  }
  .logo--dark {
    color: var(--cream);
  }
  .wordmark {
    display: flex;
    flex-direction: column;
    font-family: var(--font-logo);
    font-weight: 800;
    font-size: 18px;
    line-height: 1;
    white-space: nowrap;
  }
  em {
    font-family: var(--font-body);
    font-weight: 400;
    color: var(--rasp);
  }
  .logo--raspberry em {
    color: var(--white);
  }
  .logo--dark em {
    color: var(--rasp-on-dark);
  }
</style>
