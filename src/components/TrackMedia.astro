---
// Her running clip in a landscape or portrait frame with one track-bend corner: her own
// slowed-down loop (a small MP4) over its still, with a Pause button. Paused,
// reduced motion or no JavaScript shows the still. Used only in the version with her photos.
// Her media lives in /media (not imported), so a build without the photos
// version never ships it; astro.config copies only files a page links to.
import PauseButton from './PauseButton.astro';

interface Props {
  id: string;
  shape?: 'landscape' | 'portrait';
  // duo: navy-to-raspberry duotone, so her running matches the pink.
  tone?: 'colour' | 'duo';
  eager?: boolean;
  class?: string;
}
const { id, shape = 'landscape', tone = 'colour', eager = false, class: className } = Astro.props;
---

<figure class:list={['media', `media--${shape}`, { 'media--duo': tone === 'duo' }, className]} id={id}>
  <img class="clip-still" src="/media/run-still.jpg" width="540" height="720" decoding="async" loading={eager ? 'eager' : 'lazy'} alt="Amalia running along a park trail" />
  <video class="clip-anim" src="/media/run-loop.mp4" width="540" height="720" poster="/media/run-still.jpg" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" data-clip></video>
  <PauseButton target={id} label="the running clip" class="media-pause" />
</figure>

<script>
  import '../scripts/clips';
</script>

<style>
  .media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius) var(--radius) var(--radius) var(--radius);
    border-top-left-radius: var(--bend);
    background: var(--navy);
  }
  .media--landscape {
    aspect-ratio: 14 / 9;
  }
  .media--portrait {
    aspect-ratio: 21 / 26;
  }
  /* Her stills and loops carry two black columns on their left edge (from the
     source footage). Scaling the picture 2% from its centre crops 1% off each
     side, so it fills the frame edge to edge with no dark or navy strip. */
  .media img,
  .media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
    transform: scale(1.02);
  }
  /* Duotone: grey footage, navy in the shadows and raspberry in the light.
     Her running stays readable; the park greens turn into her brand pair. */
  .media--duo {
    isolation: isolate;
    background: var(--rasp);
  }
  .media--duo img,
  .media--duo video {
    filter: grayscale(1) contrast(1.4) brightness(0.75);
    mix-blend-mode: multiply;
  }
  .media--duo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--navy);
    mix-blend-mode: lighten;
    pointer-events: none;
  }
  .media :global(.media-pause) {
    position: absolute;
    bottom: var(--space-24);
    left: 50%;
    z-index: 2;
    translate: -50% 0;
  }
</style>
