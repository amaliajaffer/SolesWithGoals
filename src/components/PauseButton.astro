---
// Pauses moving content (WCAG 2.2.2) by adding .is-paused to the target.
interface Props {
  target: string;
  label: string;
  class?: string;
}
const { target, label, class: className } = Astro.props;
---

<button type="button" class:list={['pause', className]} data-target={target} aria-pressed="false">
  <svg class="i-pause" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M8 5v14M16 5v14"></path></svg>
  <svg class="i-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>
  <span data-pause-word>Pause</span><span class="sr-only"> {label}</span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('button.pause').forEach((button) => {
    const target = document.getElementById(button.dataset.target ?? '');
    const word = button.querySelector('[data-pause-word]');
    button.addEventListener('click', () => {
      const paused = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(paused));
      target?.classList.toggle('is-paused', paused);
      if (word) word.textContent = paused ? 'Play' : 'Pause';
    });
  });
</script>

<style>
  .pause {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 8px 16px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--navy);
    font: 700 15px/1.3 var(--font-body);
    letter-spacing: 0.01em;
    cursor: pointer;
  }
  .pause:focus-visible {
    outline: 3px solid var(--aqua);
    outline-offset: 3px;
  }
  .i-play {
    display: none;
  }
  .pause[aria-pressed='true'] .i-play {
    display: block;
  }
  .pause[aria-pressed='true'] .i-pause {
    display: none;
  }
  /* Nothing moves under reduced motion, so there's nothing to pause. */
  @media (prefers-reduced-motion: reduce) {
    .pause {
      display: none;
    }
  }
</style>
