---
// A tilted aqua ribbon across the page, like a race banner: her launch line
// and tagline repeated. Decorative (the same words are in the hero), and
// still, so nothing on the page moves without a Pause button.
import { copy } from '../data/copy';

const words = [...copy.fiveK.title, copy.essence];
const run = Array.from({ length: 4 }, () => words).flat();
---

<div class="ribbon" aria-hidden="true">
  <p class="ribbon-line">
    {
      run.map((word) => (
        <>
          <span>{word}</span>
          <span class="ribbon-dot" />
        </>
      ))
    }
  </p>
</div>

<style>
  .ribbon {
    position: relative;
    z-index: 2;
    overflow: hidden;
    padding-block: var(--space-12);
    /* The bands above and below show through the corners the tilt leaves. */
    background: linear-gradient(var(--rasp) 50%, var(--navy) 50%);
  }
  .ribbon-line {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    width: max-content;
    margin-inline: -4vw;
    padding: var(--space-16) var(--space-32);
    background: var(--aqua);
    color: var(--navy);
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 32px);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    rotate: -1.5deg;
  }
  .ribbon-dot {
    flex: none;
    width: 0.35em;
    height: 0.35em;
    border-radius: 50%;
    background: var(--rasp);
  }
</style>
