---
// Home hero without photos: the Goal Ring draws itself over moving track
// lanes (her own footage replaces this once it's approved).
import GoalRing from './GoalRing.astro';
import PauseButton from './PauseButton.astro';
import { link, type Variant } from '../lib/variant';
import { copy } from '../data/copy';

interface Props {
  variant: Variant;
}
const { variant } = Astro.props;
---

<section class="hero band-navy on-dark" id="hero-plain" aria-labelledby="hero-title">
  <div class="lanes" aria-hidden="true"></div>
  <GoalRing tone="reversed" size={460} draw class="hero-ring" />
  <div class="wrap copy">
    <div class="stack text">
      <h1 id="hero-title" class="h1">{copy.essence}</h1>
      <p class="lead">{copy.heroLine}</p>
      <div class="row">
        <a class="btn btn--primary" href={link(variant, 'the-5k')}>Join the 5K</a>
        <a class="btn btn--light" href={link(variant, 'get-involved')}>Get involved</a>
      </div>
    </div>
  </div>
  <PauseButton target="hero-plain" label="Pause the moving background" class="hero-pause" />
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(560px, 78vh, 720px);
    overflow: hidden;
  }
  .lanes {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, rgba(160, 242, 245, 0) 0 116px, rgba(160, 242, 245, 0.09) 116px 120px);
    background-size: 120px 100%;
  }
  @keyframes lanes-move {
    to {
      background-position: -240px 0;
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      translate: 0 24px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .lanes {
      animation: lanes-move 2.4s linear infinite;
    }
    .text > * {
      animation: hero-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .text > :nth-child(2) {
      animation-delay: 0.15s;
    }
    .text > :nth-child(3) {
      animation-delay: 0.3s;
    }
  }
  .is-paused .lanes {
    animation-play-state: paused;
  }
  .hero :global(.hero-ring) {
    position: absolute;
    top: 50%;
    right: 6%;
    width: min(460px, 40vw);
    height: auto;
    opacity: 0.9;
    transform: translateY(-50%);
  }
  .copy {
    position: relative;
    width: 100%;
    padding-top: 120px;
    padding-bottom: 104px;
  }
  .text {
    max-width: min(640px, 50vw);
    gap: 24px;
  }
  .hero :global(.hero-pause) {
    position: absolute;
    bottom: 28px;
    left: var(--gutter);
  }
  @media (max-width: 760px) {
    .hero :global(.hero-ring) {
      right: -18%;
      width: min(460px, 60vw);
      opacity: 0.35;
    }
    .text {
      max-width: none;
    }
  }
</style>
