---
// The Goal Ring from her logo system. Never recolour the arcs, rotate the
// ring or close the dotted gap; under 32 px use `avatar` (no dotted arc).
interface Props {
  tone?: 'primary' | 'reversed' | 'raspberry';
  size?: number;
  draw?: boolean;
  avatar?: boolean;
  label?: string;
  class?: string;
}
const { tone = 'primary', size = 40, draw = false, avatar = false, label, class: className } = Astro.props;
const colours = {
  primary: { arc: '#07195A', dots: '#DC0F5E', dot: '#DC0F5E' },
  reversed: { arc: '#FFF8F4', dots: '#A0F2F5', dot: '#FF5C93' },
  raspberry: { arc: '#FFFFFF', dots: '#FFFFFF', dot: '#07195A' },
}[tone];
---

<svg
  class:list={['ring', { 'ring--draw': draw }, className]}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path class="arc" d="M23.36 7.44A13 13 0 1 1 7 20" stroke={colours.arc} stroke-width="3.8" stroke-linecap="round"></path>
  {
    !avatar && (
      <>
        <circle class="d1" cx="8.03" cy="14.92" r="1.3" fill={colours.dots} />
        <circle class="d2" cx="10.49" cy="11.13" r="1.6" fill={colours.dots} />
        <circle class="d3" cx="14.1" cy="8.42" r="1.9" fill={colours.dots} />
      </>
    )
  }
  <circle class="d4" cx="20" cy="7" r="3.2" fill={colours.dot}></circle>
</svg>
