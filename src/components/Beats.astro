---
// "Walk it. / Wheel it. / Run it." from her launch post. The first line is
// still (it paints first); the other two rise out of a mask one after another
// like strides. The text is always in the page; under reduced motion nothing moves.
import { copy } from '../data/copy';

interface Props {
  as?: 'h1' | 'h2';
  spaced?: boolean;
  still?: boolean;
  poster?: boolean;
  id?: string;
}
// still: no rise (the moving version belongs to Home's hero only).
// poster: the three lines run across the band at poster size, stepping right.
const { as: Tag = 'h1', spaced = false, still = false, poster = false, id } = Astro.props;
const [walk, wheel, run] = copy.fiveK.title;
---

<Tag class:list={['beats', 'display-xl', { 'beats--spaced': spaced, 'beats--still': still, 'beats--poster': poster }]} id={id}>
  <span class="beat walk">{walk}</span>
  <span class="beat mask wheel"><span class="rise" style="--d: 0ms">{wheel}</span></span>
  <span class="beat mask run"><span class="rise" style="--d: 90ms">{run}</span></span>
</Tag>

<style>
  .beats {
    display: flex;
    flex-direction: column;
    color: var(--white);
  }
  .beats--spaced {
    gap: var(--space-24);
  }
  .beat {
    display: block;
  }
  /* Room for the letters inside the mask, given back underneath. */
  .mask {
    overflow: hidden;
    padding-block: 0.06em 0.1em;
    margin-block: -0.06em -0.1em;
  }
  .rise {
    display: block;
  }
  /* One race-poster face; each line takes a colour from her
     palette. All sit on raspberry at display size (white 4.9:1, aqua 3.9:1,
     navy 3.3:1; large text needs 3:1). */
  .beats {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0;
    line-height: 0.9;
    /* Condensed, so it can run larger than the other display headings. */
    font-size: clamp(68px, 9vw, 136px);
  }
  .walk {
    color: var(--white);
  }
  .wheel {
    color: var(--aqua);
  }
  .run {
    color: var(--navy);
  }
  /* Sized by width, and by height too so a short landscape phone still shows
     all three lines with the buttons. */
  .beats--poster {
    font-size: clamp(64px, min(14vw, 22vh), 200px);
    line-height: 0.86;
  }
  .beats--poster .beat:nth-child(2) {
    padding-inline-start: 18%;
  }
  .beats--poster .beat:nth-child(3) {
    text-align: end;
  }
  @keyframes beat-rise {
    from {
      transform: translateY(110%);
    }
    to {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .beats:not(.beats--still) .rise {
      animation: beat-rise 500ms cubic-bezier(0.05, 0.7, 0.1, 1) both;
      animation-delay: calc(120ms + var(--d));
    }
  }
</style>
