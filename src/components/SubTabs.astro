---
// Anchors to the parts of one page, sticky at the top while you read. The pill
// for the part you're in fills navy.
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

<nav class="subtabs" aria-label="On this page">
  <ul class="wrap">
    {
      items.map((item, index) => (
        <li>
          <a href={`#${item.id}`} class:list={{ 'is-cur': index === 0 }} aria-current={index === 0 ? 'location' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.subtabs a'));
  const targets = links.map((a) => document.querySelector<HTMLElement>(a.hash)).filter((el): el is HTMLElement => el !== null);
  const mark = (id: string) => {
    for (const a of links) {
      const on = a.hash === `#${id}`;
      a.classList.toggle('is-cur', on);
      if (on) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    }
  };
  const spy = () => {
    const line = window.innerHeight * 0.35;
    let current = targets[0]?.id;
    for (const target of targets) if (target.getBoundingClientRect().top <= line) current = target.id;
    if (current) mark(current);
  };
  if (links.length) {
    window.addEventListener('scroll', spy, { passive: true });
    spy();
  }
</script>

<style>
  .subtabs {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: var(--space-24) 0;
    background: var(--cream);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0 auto;
    list-style: none;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 16px;
    border: 2px solid var(--navy-100);
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--navy);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  a:hover {
    border-color: var(--navy);
    color: var(--navy);
  }
  a.is-cur {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--white);
  }
  li {
    flex: none;
  }
  /* Phones: one row that scrolls sideways instead of wrapping. */
  @media (max-width: 560px) {
    .subtabs {
      padding: var(--space-12) 0;
    }
    ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    /* Room after the last tab so it doesn't end against the screen edge. */
    ul::after {
      content: '';
      flex: 0 0 calc(var(--gutter) - var(--space-8));
    }
    ul::-webkit-scrollbar {
      display: none;
    }
  }
</style>
