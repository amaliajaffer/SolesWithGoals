---
// A way to help, drawn as her "My goal" race bib. Until its form exists, the
// band says "Opening soon" and the bib has no button. "Run with us" is the
// raspberry bib.
interface Props {
  title: string;
  text?: string | null;
  href?: string | null;
  run?: boolean;
  wide?: boolean;
  // Rows fill on wider screens: the bib takes two columns when the count leaves a gap.
  span?: { three: boolean; two: boolean };
  id?: string;
  label?: string;
}
const { title, text, href, run = false, wide = false, span, id, label = 'Open the form' } = Astro.props;
const external = href ? /^https?:/.test(href) : false;
---

<article class:list={['bib', { 'bib--run': run, 'bib--wide': wide, 'bib--span3': span?.three, 'bib--span2': span?.two }]} id={id}>
  <div class="band">
    <span class="mark"><span class="pin" aria-hidden="true"></span>My goal</span>
    {href ? <span class="pin" aria-hidden="true"></span> : <span class="status">Opening soon</span>}
  </div>
  <div class="bib-body">
    <h3 class="h3">{title}</h3>
    {text && <p class="line">{text}</p>}
    {
      href && (
        <a class="btn" href={href} rel={external ? 'noopener' : undefined}>
          {label}
          {external && <span class="sr-only"> for {title} (opens a Google Form)</span>}
        </a>
      )
    }
  </div>
</article>

<style>
  .bib {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--navy-100);
    border-radius: var(--radius);
    background: var(--white);
    scroll-margin-top: 96px;
  }
  .band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-12) var(--space-16);
    background: var(--aqua);
    color: var(--navy);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
  }
  .bib--run .band {
    background: var(--rasp);
    color: var(--white);
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-12);
  }
  .status {
    padding: 2px var(--space-12);
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--navy);
    text-transform: none;
    white-space: nowrap;
  }
  .pin {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--white);
  }
  .bib-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-12);
    padding: var(--space-24);
  }
  .line {
    color: var(--navy-700);
  }
  .bib-body .btn {
    margin-top: auto;
  }
  @media (min-width: 1024px) {
    .bib--span3 {
      grid-column: span 2;
    }
  }
  @media (min-width: 721px) and (max-width: 1023px) {
    .bib--span2 {
      grid-column: 1 / -1;
    }
  }
  /* Phones: two bibs a row, each only as tall as its row needs. */
  @media (max-width: 720px) {
    .band {
      padding: var(--space-8) var(--space-12);
    }
    .bib-body {
      gap: var(--space-8);
      padding: var(--space-16);
    }
    .bib--wide {
      grid-column: 1 / -1;
    }
    .band {
      font-size: 15px;
    }
    .status {
      padding: 2px var(--space-8);
    }
  }
</style>
